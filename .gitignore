# Local virtualenv used by the build script
.venv/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# dist/ is intentionally committed: Render's build image may not ship Python,
# in which case the shim publishes this prebuilt output. It must stay byte-for-
# byte identical to a fresh `bash scripts/build.sh` (enforced by
# site/tests/test_render_compat.py).

# Node test harness dependencies
site/tests/js/node_modules/
node_modules/
